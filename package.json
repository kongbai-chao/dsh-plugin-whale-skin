{
  "name": "dsh-plugin-whale-skin",
  "version": "0.1.0",
  "description": "Deep-sea whale-girl theme: a deep-blue skin for the DeepSeek Harness desktop client, with light and dark palettes.",
  "icon": "assets/icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://example.invalid/dsh-plugin-whale-skin"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale",
    "assets/icon.svg",
    "README.md",
    "LICENSE"
  ]
}
